# Copiá este archivo como ".env" y completá los valores.

# Conexión a MySQL (con XAMPP normalmente es usuario "root" sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deudascero

# Puerto del servidor (80 = se entra solo con la IP)
PORT=3000

# Administrador que se crea la primera vez (cambiá la contraseña)
ADMIN_EMAIL=admin@finanzasjoven.com
ADMIN_PASSWORD=admin123
