# Copiá este archivo como ".env" y completá los valores.

# Cadena de conexión de Supabase:
# Supabase → tu proyecto → botón "Connect" → "Session pooler" → copiar la URI
# y reemplazar [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU-CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Puerto del servidor (80 = se entra solo con la IP)
PORT=3000

# Administrador que se crea la primera vez (cambiá la contraseña)
ADMIN_EMAIL=admin@finanzasjoven.com
ADMIN_PASSWORD=admin123
